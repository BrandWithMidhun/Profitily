{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate", "^generate"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate", "^generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
