# ── Profitily AI — environment template (copy to .env; fill real values) ──
# All defaults point at local OSS services from tooling/docker-compose.yml.
# NEVER commit a filled-in .env.

# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Local infra HOST ports (tooling/docker-compose.yml). Defaults are canonical.
# Override these (and the matching *_URL/PORT below) only if another local stack
# already uses a port — e.g. run `DB_HOST_PORT=5433 REDIS_HOST_PORT=6380` to run
# Profitily alongside another Postgres/Redis. Container-internal ports never change.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
OLLAMA_HOST_PORT=11434

# Database (Postgres + TimescaleDB)
DATABASE_URL=postgresql://profitily:profitily@localhost:5432/profitily

# Cache / queue (Redis or Valkey)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO — S3-compatible). Swap to R2/S3 in prod via these same vars.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=profitily-reports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Profitily <reports@profitily.local>"

# Auth / crypto
JWT_SECRET=change-me-dev-only
ENCRYPTION_KEY=change-me-32-byte-dev-key-000000   # AES-256-GCM secret-at-rest master key (HKDF-SHA256 derived); >=32 chars

# Shopify (dev app)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Least-privilege read scopes for profit ingestion (TASK-010). read_all_orders (>60d
# historical) needs Shopify approval -> deferred to backfill (TASK-021); read_inventory
# only if COGS/stock needs it later.
SHOPIFY_SCOPES=read_orders,read_products,read_customers
SHOPIFY_API_VERSION=2026-04
SHOPIFY_APP_URL=http://localhost:3000

# AI — local-first. Escalation keys optional; leave blank to stay 100% local.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_ESCALATION_ENABLED=false
ANTHROPIC_API_KEY=        # only used when AI_ESCALATION_ENABLED=true
OPENAI_API_KEY=           # optional secondary

# Integrations (sandbox/dev credentials — fill when wiring each provider)
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPWAY_USERNAME=
SHIPWAY_PASSWORD=
DELHIVERY_API_TOKEN=

# Observability (OSS)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GLITCHTIP_DSN=
