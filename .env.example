# ── Profitily AI — environment template (copy to .env; fill real values) ──
# All defaults point at local OSS services from tooling/docker-compose.yml.
# NEVER commit a filled-in .env.

# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Database (Postgres + TimescaleDB)
DATABASE_URL=postgresql://profitily:profitily@localhost:5432/profitily

# Cache / queue (Redis or Valkey)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO — S3-compatible). Swap to R2/S3 in prod via these same vars.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=profitily-reports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Profitily <reports@profitily.local>"

# Auth / crypto
JWT_SECRET=change-me-dev-only
ENCRYPTION_KEY=change-me-32-byte-dev-key-000000   # envelope encryption master key

# Shopify (dev app)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory
SHOPIFY_APP_URL=http://localhost:3000

# AI — local-first. Escalation keys optional; leave blank to stay 100% local.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_ESCALATION_ENABLED=false
ANTHROPIC_API_KEY=        # only used when AI_ESCALATION_ENABLED=true
OPENAI_API_KEY=           # optional secondary

# Integrations (sandbox/dev credentials — fill when wiring each provider)
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPWAY_USERNAME=
SHIPWAY_PASSWORD=
DELHIVERY_API_TOKEN=

# Observability (OSS)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GLITCHTIP_DSN=
