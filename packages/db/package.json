{
  "name": "@profitily/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@profitily/shared": "workspace:*"
  },
  "devDependencies": {
    "@profitily/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "eslint": "^9.20.0",
    "pg": "^8.13.1",
    "prisma": "^6.19.3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
